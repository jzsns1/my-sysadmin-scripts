[Unit]
Description=my-app service
After=docker.service raid-lab.service
Requires=docker.service
Wants=raid-lab.service

[Service]
ExecStart=/usr/bin/docker start -a my-app
ExecStop=/usr/bin/docker stop my-app
Restart=on-failure
# docker start -a возвращает код контейнера; 143 = остановлен по SIGTERM (docker stop), это не ошибка
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
